APP_NAME="Akses SMAAFBS"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://app.smaafbs.sch.id

APP_LOCALE=id
APP_FALLBACK_LOCALE=id
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

WEBAUTHN_ENABLED=false
WEBAUTHN_RP_NAME="SMA AFBS"
WEBAUTHN_RP_ID=app.smaafbs.sch.id
WEBAUTHN_ORIGIN=https://app.smaafbs.sch.id
WEBAUTHN_TIMEOUT_SECONDS=60
WEBAUTHN_CHALLENGE_TTL_MINUTES=5
WEBAUTHN_MAX_CREDENTIALS_PER_USER=5

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=
DB_USERNAME=
DB_PASSWORD=
MIGRATIONS_TABLE=laravel_migrations

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=true
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax

# Header keamanan browser. CSP dimulai report-only agar Filament/Livewire dapat
# diaudit sebelum mode enforce diaktifkan.
SECURITY_HEADERS_ENABLED=true
SECURITY_CSP_MODE=report-only
SECURITY_HSTS_MAX_AGE=300
SECURITY_REFERRER_POLICY=strict-origin-when-cross-origin

SPMB_SYNC_BASE_URL=https://seleksi.smaafbs.sch.id
SPMB_SYNC_TOKEN=
SPMB_SYNC_TIMEOUT=30

# API privat server-to-server untuk sinkronisasi master siswa ke aplikasi tagihan.
# Gunakan token acak 256-bit (contoh: 64 karakter hex) dan jangan kirim ke frontend/log.
TAGIHAN_STUDENT_API_TOKEN=
TAGIHAN_STUDENT_API_REQUIRE_HTTPS=true

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=public
# Optional untuk hosting yang folder /storage publiknya tidak sama dengan public_path('storage').
# Contoh: FILESYSTEM_PUBLIC_ROOT=/home/cpaneluser/public_html/web/app/storage
# FILESYSTEM_PUBLIC_ROOT=
QUEUE_CONNECTION=database
DB_QUEUE_RETRY_AFTER=180

ASSESSMENT_MODULE_ENABLED=false
ASSESSMENT_REPORT_DISK=local
ASSESSMENT_REPORT_QUEUE=assessment-reports
ASSESSMENT_REPORT_WORKER_MAX_TIME=50
ASSESSMENT_REPORT_WORKER_TIMEOUT=180
ASSESSMENT_REPORT_STUDENTS_PER_JOB=3
ASSESSMENT_REPORT_PIPELINE_MAX_SECONDS=40
ASSESSMENT_SHARE_EXPIRY_HOURS=24
ASSESSMENT_SHARE_RATE_LIMIT=30
LITERACY_SIMILARITY_QUEUE=literacy-analysis
LITERACY_SIMILARITY_THRESHOLD=80
LITERACY_SUBMISSION_QUEUE_ENABLED=true
LITERACY_SUBMISSION_ACTIVE_SLOTS=10
LITERACY_SUBMISSION_POLL_SECONDS=5
LITERACY_SUBMISSION_POLL_MIDDLE_SECONDS=12
LITERACY_SUBMISSION_POLL_FAR_SECONDS=25
LITERACY_SUBMISSION_POLL_MIDDLE_POSITION=30
LITERACY_SUBMISSION_POLL_FAR_POSITION=100
LITERACY_SUBMISSION_WAIT_TTL_MINUTES=10
LITERACY_SUBMISSION_MASS_MODE_ENABLED=true
LITERACY_SUBMISSION_INITIAL_JITTER_SECONDS=30
LITERACY_SUBMISSION_NORMAL_INITIAL_JITTER_SECONDS=2
LITERACY_SUBMISSION_RETRY_DELAYS_SECONDS=5,10,20,30
LITERACY_SUBMISSION_RETRY_WINDOW_SECONDS=600
LITERACY_SUBMISSION_DRAFT_TTL_HOURS=12
LITERACY_SCHOOL_MONITOR_TOKEN=
LITERACY_SCHOOL_MONITOR_STALE_MINUTES=3
APP_ACCESS_LOG_PATH=
LITERACY_SUBMISSION_ANALYSIS_IDLE_SECONDS=180
LITERACY_SUBMISSION_ADMISSION_TTL_SECONDS=60

# Sinkron data API dari server pusat.
# Nilai ini bisa dikelola dari Admin > Pengaturan > Sinkron Data API.
SERVER_SYNC_API_ENABLED=true
SERVER_SYNC_DOMAIN=https://app.smaafbs.sch.id

# Khusus komputer lokal yang akan menarik salinan penuh dari server.
# Jangan menaruh private key atau password server di repository.
# SERVER_SYNC_SSH_HOST=app.smaafbs.sch.id
# SERVER_SYNC_SSH_USER=
# SERVER_SYNC_SSH_PORT=2223
# SERVER_SYNC_SSH_KEY="C:/Users/NamaUser/.ssh/id_rsa"
# SERVER_SYNC_SSH_KNOWN_HOSTS="storage/app/server-sync/ssh/known_hosts"
# SERVER_SYNC_REMOTE_PATH=/home/cpaneluser/akses2-laravel
# SERVER_SYNC_REMOTE_DB_HOST=localhost
# SERVER_SYNC_REMOTE_DB_PORT=3306
# SERVER_SYNC_REMOTE_DB_DATABASE=
# SERVER_SYNC_REMOTE_DB_USERNAME=
# SERVER_SYNC_REMOTE_DB_PASSWORD=
# SERVER_SYNC_STORAGE_PATHS=public/storage:public/storage,storage/app/public:storage/app/public,storage/app/private:storage/app/private
# SERVER_SYNC_BACKUP_LOCAL=true
# SERVER_SYNC_SSH_BINARY="C:/Windows/System32/OpenSSH/ssh.exe"
# SERVER_SYNC_SCP_BINARY="C:/Windows/System32/OpenSSH/scp.exe"
# SERVER_SYNC_MYSQL_BINARY="E:/xampp/mysql/bin/mysql.exe"
# SERVER_SYNC_MYSQLDUMP_BINARY="E:/xampp/mysql/bin/mysqldump.exe"
# SERVER_SYNC_SCHTASKS_BINARY="C:/Windows/System32/schtasks.exe"
# SERVER_SYNC_RUNNER_TASK=Akses2ServerSyncRunner
# SERVER_SYNC_TIMEOUT=3600
# SERVER_SYNC_LOG_LEVEL=info
# SERVER_SYNC_LOG_DAYS=30

CACHE_STORE=database
CACHE_LIMITER_STORE=database
# CACHE_PREFIX=

ADMIN_PERFORMANCE_MONITOR_ENABLED=false
ADMIN_PERFORMANCE_REQUEST_THRESHOLD_MS=1500
ADMIN_PERFORMANCE_QUERY_THRESHOLD_MS=800
ADMIN_SLOW_QUERY_THRESHOLD_MS=400
ADMIN_PERFORMANCE_LOG_CHANNEL=admin_performance

# Isi hanya alamat proxy hosting jika aplikasi benar-benar berada di belakang
# reverse proxy. Gunakan null saat LiteSpeed menerima koneksi secara langsung.
TRUSTED_PROXIES=null
TRUSTED_PROXY_HEADERS=all

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
ASSESSMENT_REPORT_INDIVIDUAL_MODE=stream
ASSESSMENT_REPORT_CLASS_CACHE_HOURS=24
ASSESSMENT_REPORT_RENDER_ACTIVE_SLOTS=1
ASSESSMENT_REPORT_RENDER_LOCK_SECONDS=180
ASSESSMENT_REPORT_RENDER_RETRY_AFTER_SECONDS=10
HOSTING_STORAGE_ROOT=
HOSTING_DISK_QUOTA_GB=10

# Sinkron akun WiFi (baca) dari aplikasi MikroTik (mikrotik.smaafbs.sch.id)
WIFI_SYNC_ENABLED=false
WIFI_SYNC_BASE_URL=https://mikrotik.smaafbs.sch.id
WIFI_SYNC_TOKEN=
WIFI_SYNC_TIMEOUT=30
